{
  "manifest_version": 3,
  "name": "Nexus Accounting 助手",
  "version": "1.8.9",
  "description": "适用于 Nexus Legacy NX-S0 与 NX-NF 的数据统计、舰队规划和游戏内辅助工具。",
  "author": "Verrok (maintained by Einzieg)",
  "homepage_url": "https://github.com/Einzieg/NexusAccounting",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "downloads",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "https://s0.nexuslegacy.space/*",
    "https://nf.nexuslegacy.space/*"
  ],
  "background": {
    "service_worker": "background-sw.js",
    "scripts": [
      "background-sw.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Nexus Accounting 助手",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["game-api-bridge.js", "server-storage.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["sidebar-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["galaxy-fetch-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["galaxy-fields.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["empire-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["guide-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["logistics-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["upgrade-queue.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["building-upgrade.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["tech-upgrade.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://s0.nexuslegacy.space/*", "https://nf.nexuslegacy.space/*"],
      "js": ["ship-upgrade.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "simulator.html"
      ],
      "matches": [
        "https://s0.nexuslegacy.space/*",
        "https://nf.nexuslegacy.space/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nexus-accounting@verrok",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  }
}
